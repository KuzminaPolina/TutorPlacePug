mixin header(headerMods, currentUrl)
  -
    const headerLinks = [
      {
        href: "index.html",
        text: "Главная"
      },
      {
        href: "#",
        text: "Преимущества"
      },
    ]

  header.header(class=headerMods)
    .container
      .header__logo-wrpr
        .header__decor
        if(currentUrl === "index.html")
          span.header__logo  AI
        else
          a.header__logo(href="index.html", aria-label="Переход на главную") AI
      nav.main-nav
        .main-nav__wrapper
          ul.main-nav__list
            each link in headerLinks
              - const activeState = currentUrl === link.href
              li.main-nav__item
                if(activeState)
                  span.main-nav__link.is-active= link.text
                else
                  a.main-nav__link(href=link.href)= link.text
            li.main-nav__item
              +btn({text: "Получить доступ"})(data-open-modal="form", class="main-nav__btn")
      button.main-nav__toggle.btn-reset(type="button", aria-label="Переключатель отображения меню", aria-pressed="false")
        +icon("menu-open", 20, 20)(class="main-nav__open")
        +icon("menu-close", 20, 20)(class="main-nav__close visually-hidden")
