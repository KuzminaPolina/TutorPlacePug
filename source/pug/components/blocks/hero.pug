mixin hero()
  section.hero
    .hero__text
      h1.hero__header Нейросеть
      span.hero__underheader может всё!
      p.hero__tagline Мы уже живем в этой удивительной реальности
      +btn({text: "Погрузиться в новый мир"})(data-open-modal="form", class="hero__button")
    .hero__picture
      picture.hero__pic
        source(type="image/webp", media="(max-width: 767px)", srcset="./img/content/hero-img-mobile.webp 1x, ./img/content/hero-img-mobile@2x.webp 2x")
        source(type="image/webp", srcset="./img/content/hero-img.webp 1x, ./img/content/hero-img@2x.webp 2x")
        source(type="image/jpg", media="(max-width: 767px)", srcset="./img/content/hero-img-mobile.png 1x, ./img/content/hero-img-mobile@2x.png 2x")
        img.hero__img(src="img/content/hero-img.png", srcset="img/content/hero-img@2x.png 2x", width="640", height="726", alt="header image")
