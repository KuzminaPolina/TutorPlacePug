mixin advantages()
  - const cards = [{icon: "icon-one", title: "Хотите открыть бизнес?", text: "Нейросеть поможет составить бизнес-план, рассчитать расходы, нарисовать логотип, найти место получше и станет вашим главным деловым партнером"}, {icon: "icon-two", title: "Мечтаете об отпуске?", text: "Нейросеть поможет найти место по вашим запросам, выбрать наилучший сезон, собрать чемодан, подыскать где остановиться и сделать ваш отпуск незабываемым"}, {icon: "icon-three", title: "Вы студент и нуждаетесь в помощи в учебе?", text: "Нет проблем! Нейросеть — ваш лучший друг, который поможет написать курсовую, решить сложный тест и подготовиться к экзаменам"}, {icon: "icon-four", title: "Интересует здоровый образ жизни?", text: "Нейросеть поделится советами по сбалансированному питанию, безопасным тренировкам и поддержке мотивации."}]

  section.advantages
    .advantages__text
      h2.advantages__header Преимущества курса
      p.advantages__tagline Хотите открыть бизнес?
      p.advantages__tagline Поможем создать <span class="advantages__highlight">корректный промт</span>, чтобы вы получили максимально корректный вариант под ваши нужды!
      p.advantages__decor Преимущества
    .advantages__cards
      ul.advantages__list
        each card in cards
          li.advantages__card
            +icon(card.icon, 48, 48)
            p.advantages__title #{card.title}
            p.advantages__decr #{card.text}
